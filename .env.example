# Example environment variables. Copy to `.env` and fill in.
# NEVER commit real secrets.

# Base URL of the Lumen API (backend).
VITE_API_URL=https://api.lumen.app

# Analytics. Plausible / PostHog / similar. Optional.
VITE_ANALYTICS_KEY=

# Web Push / VAPID public key for push notifications. Optional.
VITE_WEB_PUSH_PUBLIC=

# Feature flags (all optional)
VITE_FLAG_PREMIUM=true
VITE_FLAG_LIVE=true
VITE_FLAG_CREATOR_TOOLS=true
